{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "aim4-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "aim4-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "server"
      ],
      "port": 3784
    },
    {
      "name": "aim4-comms-host",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "host"
      ],
      "port": 3799,
      "autoPort": false,
      "env": {
        "AIM4_API_PORT": "3799"
      }
    },
    {
      "name": "aim4-cols-host",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "host"
      ],
      "port": 3811,
      "autoPort": false,
      "env": {
        "AIM4_API_PORT": "3811"
      }
    }
  ]
}
