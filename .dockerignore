# The image only needs package*.json + server/ (see Dockerfile). Everything
# else — installed deps, the client build, source, git, host-mode data — is
# excluded to keep the build context small and the image clean.
node_modules
dist
.git
.gitignore
index.html
vite.config.js
vercel.json
Dockerfile
.dockerignore
# Host state, and nothing here can change that: Coolify mounts a named volume
# over /app/server/data, so anything the image carries at that path is
# shadowed at runtime. The cs3d pack lives in the volume alongside replays —
# it is uploaded once per host, not built in. Un-excluding it here only makes
# the context and image 91 MB fatter for bytes the server can never read.
server/data
*.bat
.env
.env.*
*.md
