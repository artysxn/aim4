{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/tools/editvalues", "destination": "/tools/editvalues.html" },
    { "source": "/tools/level-editor", "destination": "/tools/level-editor.html" },
    { "source": "/tools/zone-editor", "destination": "/tools/zone-editor.html" },
    { "source": "/tools", "destination": "/index.html" },
    { "source": "/training", "destination": "/index.html" },
    { "source": "/leaderboards", "destination": "/index.html" },
    { "source": "/routines", "destination": "/index.html" },
    { "source": "/achievements", "destination": "/index.html" },
    { "source": "/map-practice", "destination": "/index.html" },
    { "source": "/replay-viewer", "destination": "/index.html" },
    { "source": "/demos", "destination": "/index.html" },
    { "source": "/playlists", "destination": "/index.html" },
    { "source": "/database", "destination": "/index.html" },
    { "source": "/charts", "destination": "/index.html" },
    { "source": "/patterns", "destination": "/index.html" },
    { "source": "/performance", "destination": "/index.html" },
    { "source": "/uploads", "destination": "/index.html" },
    { "source": "/team", "destination": "/index.html" },
    { "source": "/team/(.*)", "destination": "/index.html" },
    { "source": "/account", "destination": "/index.html" },
    { "source": "/account/(.*)", "destination": "/index.html" },
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/sim", "destination": "/index.html" },
    { "source": "/i/(.*)", "destination": "/index.html" },
    { "source": "/s2/(.*)", "destination": "/index.html" },
    { "source": "/d/(.*)", "destination": "/index.html" },
    { "source": "/replays", "destination": "/index.html" },
    { "source": "/replays/playlists", "destination": "/index.html" },
    { "source": "/replays/upload", "destination": "/index.html" },
    { "source": "/replays/stats", "destination": "/index.html" },
    { "source": "/replays/analytics", "destination": "/index.html" },
    { "source": "/replays/charts", "destination": "/index.html" },
    { "source": "/football", "destination": "/index.html" },
    { "source": "/(dust2|mirage|inferno|nuke|ancient|anubis|cache)", "destination": "/cs3d.html" },
    { "source": "/de_(dust2|mirage|inferno|nuke|ancient|anubis|cache)", "destination": "/cs3d.html" },
    { "source": "/((?!assets/|tools/|fonts/|icons/|maps/).*)", "destination": "/train.html" }
  ]
}
