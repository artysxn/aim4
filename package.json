{
  "name": "aim-trainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A web-based Aim Trainer built with Three.js, Pointer Lock API and Vite.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host",
    "dev:mp": "node server/run-dev.js",
    "server": "node server/index.js",
    "host": "node server/run-host.js",
    "build": "vite build",
    "preview": "vite preview",
    "parse-demo": "node tools/parse-demo-local.js",
    "parse-demo:gui": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/parse-demo-gui.ps1",
    "sample-map-control-bases": "node scripts/sample-map-control-bases.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.108.2",
    "jose": "^6.2.4",
    "three": "^0.169.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "vite": "^5.4.8"
  },
  "optionalDependencies": {
    "@laihoe/demoparser2": "^0.41.3"
  }
}
