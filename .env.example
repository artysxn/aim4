# ---------------------------------------------------------------------------
# AIM4.io — environment variables
# Copy to `.env` for local overrides (Vite auto-loads .env; never commit it).
# Variables are split by where they run: CLIENT (build-time, Vite) vs SERVER
# (runtime, Node). CLIENT vars MUST be prefixed VITE_ to be exposed to the app.
# ---------------------------------------------------------------------------

# === CLIENT (build-time, baked into the bundle by Vite) =====================

# Backend origin for the config-share REST API *and* multiplayer (WS + status).
# Leave EMPTY for local dev and LAN/host mode (the client talks to the same
# origin that served it, and Vite proxies /api + /ws to the backend).
# Set it for a SPLIT deploy where the client and backend are on different
# origins (static host for the client, a Node host for the backend). Include
# the scheme, no trailing slash. The client derives the WebSocket URL from
# this automatically (https -> wss).
#   Production example:
# VITE_API_URL=https://api.aim4.io
VITE_API_URL=

# Supabase — auth, cloud settings sync, account leaderboards.
# Get these from Supabase → Project Settings → API (publishable/anon key).
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-publishable-key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google OAuth (configured in Supabase dashboard, not here):
#   Authentication → Providers → Google — enable + add client ID/secret
#   Authentication → URL configuration — add redirect URLs:
#     https://aim4.io
#     http://localhost:5173   (Vite dev)
#   Authentication → Settings → enable “Manual linking” (required for
#     “Link Google account” on My account for email/password users)
# The app uses window.location.origin as redirectTo automatically.

# === SERVER (runtime, Node — server/index.js) ==============================

# Interface to bind. 127.0.0.1 (default) for local-only; 0.0.0.0 to accept
# connections from the network — REQUIRED when hosted, and for LAN/host mode.
AIM4_HOST=127.0.0.1

# Port for the HTTP API + WebSocket. Defaults to 3784. `PORT` is honored as a
# fallback, which is what most hosts inject; match your host's expected port.
AIM4_API_PORT=3784

# Optional labels shown in the multiplayer HUD and /api/mp/status. Set these to
# whatever your host calls the region and instance; both are cosmetic.
# AIM4_REGION=fra
# AIM4_INSTANCE_ID=

# Serve the built client (dist/) from the Node server too ("1" or "true").
# Used by host mode (`npm run host`) so one process serves both
# the game and multiplayer on the same origin. NOT needed when the client is
# hosted separately (e.g. on Vercel).
AIM4_SERVE_STATIC=0

# --- Replays (demo library) -------------------------------------------------

# A demo library is PRIVATE, so the backend verifies the caller's Supabase
# access token and takes the account id from it. Set ONE of these:
#
#   SUPABASE_URL          modern projects (asymmetric keys). The backend reads
#                         <url>/auth/v1/.well-known/jwks.json to get the
#                         verification keys. Override with SUPABASE_JWKS_URL.
#   SUPABASE_JWT_SECRET   legacy projects that still sign with a shared HS256
#                         secret (Supabase → Settings → API → JWT Settings).
#
# With NEITHER set, libraries fall back to the X-Aim4-User header and are NOT
# access controlled: anyone who knows an account id can read that library. The
# server logs a warning on the first such request. Local dev only.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_JWT_SECRET=
# SUPABASE_JWKS_URL=

# --- Entitlements, tiers and admin ------------------------------------------

# Token verification uses SUPABASE_URL plus the anon key.
SUPABASE_ANON_KEY=

# Server-side privileged key. NEVER exposed to the client bundle and never
# prefixed VITE_, which would inline it into the built JS. It bypasses RLS, so
# it is the one credential in this file that must not reach a browser.
#
# Without it the server fails closed rather than open: every account resolves to
# the free tier, admin actions are unavailable, and public reads keep working.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated auth.users UUIDs seeded into site_admins at boot. Bootstrap
# only; after the first run the table is the source of truth, and removing a
# UUID here never deletes a row.
#
# Admin is keyed by UUID, never by username. A username is user-changeable and
# claimable, so a username-based admin list means anyone who claims a listed
# name that is not currently registered becomes a site admin.
AIM4_ADMIN_USER_IDS=

# Signing secret for "view as" tickets. Derived from SUPABASE_SERVICE_ROLE_KEY
# when unset, which is correct for a single backend process.
# AIM4_IMPERSONATION_SECRET=

# --- Trial ------------------------------------------------------------------

AIM4_TRIAL_DAYS=7
AIM4_TRIAL_PLAN=premium
AIM4_TRIAL_ENABLED=1

# Shared library folder name under AIM4_REPLAY_DIR (default: local). Point this
# at an existing per-account folder if you previously keyed libraries by user id.
# AIM4_REPLAY_LIBRARY=local

# Where uploaded .dem files and parsed rounds are stored. Defaults to
# server/data/replays. Point this at a mounted volume in production: the
# library is the only state on disk that cannot be rebuilt.
# Position Editor data also lives here under zones/<MAP>.json (same volume as
# round notes). Override with AIM4_ZONES_DIR only if you need a separate path.
# AIM4_REPLAY_DIR=/data/replays
# AIM4_ZONES_DIR=/data/replays/zones

# Shared server-wide library storage limit (one pool for every visitor).
# Default: 20 GB. There is no per-demo count cap.
# AIM4_REPLAY_MAX_BYTES=21474836480

# Largest single upload, default 5 GB. A .zip may hold as many demos as it likes
# within this; the count is not capped, only the bytes. Separate from the
# library limit above because the archive lands on disk whole before anything is
# extracted, and one request that large also has to arrive inside
# AIM4_REQUEST_TIMEOUT_MS. Raising this means raising that too: 5 GB in 30
# minutes already needs a sustained ~2.8 MB/s from the client.
# AIM4_MAX_UPLOAD_BYTES=5368709120

# Keep the source .dem (and any archive it arrived in) after parsing. Off by
# default: the source is deleted once parsing ends, win or lose, and only the
# parsed rounds are kept. Set to "1" while debugging a parser change, since a
# failed demo otherwise has to be re-uploaded rather than retried.
# AIM4_REPLAY_KEEP_DEM=1

# Which demo parser adapter to use (see server/demoparser/README.md). Defaults
# to the first registered adapter that reports itself available.
# AIM4_DEMO_PARSER=laihoe

# --- Parse cost and blast radius --------------------------------------------
# Parsing runs in a worker thread. These three bound what it can consume.

# Heap ceiling for the parse worker, in MB. Default 1536. This is a blast
# radius control: without it, a worker that runs out of memory takes the whole
# server down, killing live multiplayer matches too. Must fit in the host's RAM
# alongside everything else, so lower it on a small box (a 2 GB host wants
# ~768) and raise it only if there is genuinely spare memory.
# AIM4_PARSE_HEAP_MB=1536

# How many demo ticks to parse per pass. Unset, this is derived from the cgroup
# memory limit at about 20 ticks per available MB, so a 4 GB box lands near
# 80000 and a 16 GB box at the 200000 ceiling. Every parseTicks call re-decodes
# the whole demo file, so larger is faster wherever it fits; the derivation
# exists because "fits" depends on the host. Setting this pins it and disables
# the derivation. See GET /api/replays/diag for the value in use.
# AIM4_PARSE_BATCH_TICKS=80000

# How many times a parse killed by the OOM killer is retried, each time with
# half the batch size (floor 15000). Default 3. An identical retry would just
# reproduce the kill, so this is what turns "too large for this box" from an
# endless failure loop into a slower parse that succeeds.
# AIM4_PARSE_ATTEMPTS=3

# Give up on a parse that reports no progress for this long. Default 15 min.
# AIM4_PARSE_STALL_MS=900000

# --- Uploads ----------------------------------------------------------------
# How long a single request may take, in ms. Default 30 min. Node's own default
# is 5 minutes, which aborts large demo uploads mid-transfer.
# AIM4_REQUEST_TIMEOUT_MS=1800000

# --- FACEIT ingest ----------------------------------------------------------
# Pulls demos from FACEIT tournaments: webhook says a demo is ready, the
# ingester exchanges its resource URL for a signed download, parses, deletes.
# See FACEIT-INGEST-PLAN.md.

# Server-side API key from the FACEIT App Studio (developers.faceit.com).
# Bearer for the Data API, and for the demo URL exchange once the Downloads API
# application is approved. A client-side key will not work for either.
# AIM4_FACEIT_API_KEY=

# Our own secret, not one FACEIT issues. Invent a long random value, set it
# here, and paste the SAME value into the webhook subscription's "Security
# header value" field in App Studio. FACEIT does not sign its webhooks, so this
# is the only thing separating a real delivery from anyone who finds the URL.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Unset means every delivery is rejected, which is deliberate: this endpoint is
# public and fail-open would let anyone queue ingest work.
# AIM4_FACEIT_WEBHOOK_SECRET=

# Header carrying that secret. Must match "Security header name" in App Studio.
# AIM4_FACEIT_WEBHOOK_HEADER=x-aim4-webhook-secret

# Only for deployments that cannot pass a custom header (a proxy that strips
# unknown ones). Matches App Studio's "Security query string name". Leave unset
# to use the header alone; the same secret value is checked either way.
# AIM4_FACEIT_WEBHOOK_QUERY=

# Which events become ingest work. FACEIT scopes subscriptions to ORGANIZERS,
# not to individual tournaments, so a subscription delivers everything that
# organizer runs and this is where a specific tournament gets picked out.
# Comma-separated ids; both unset means "take everything the subscription sends".
# AIM4_FACEIT_CHAMPIONSHIPS=
# AIM4_FACEIT_ORGANIZERS=

# Where the webhook receiver drops envelopes for the ingester to pick up.
# Needs the same persistent disk as the ledger.
# AIM4_FACEIT_SPOOL_DIR=/data/faceit-ingest/spool

# Safety-net poll of finished matches, for events that never arrived (a missed
# delivery, or an organizer we cannot subscribe to). 0 disables it.
# AIM4_FACEIT_POLL_MINUTES=15
